{
  "name": "overlay-lupin",
  "version": "0.3.0",
  "description": "같은 Wi-Fi/LAN에서 즉석으로 붙는, 화면 위에 몰래 떠 있는 미니게임 모음 오버레이",
  "author": "hyungi",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer',{recursive:true});fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "test": "npm run build && node tests/simulation.test.mjs && node tests/cell.test.mjs && node tests/fence.test.mjs && node tests/worm.test.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "release:mac": "npm run build && electron-builder --mac --publish=never",
    "release:win": "npm run build && electron-builder --win --publish=never"
  },
  "devDependencies": {
    "@types/node": "*",
    "electron": "*",
    "electron-builder": "*",
    "typescript": "*"
  },
  "build": {
    "appId": "com.hyungi.overlaylupin",
    "productName": "Overlay Lupin",
    "files": ["dist/**/*", "package.json"],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
