{
  "name": "overlay-lupin",
  "version": "0.9.3",
  "description": "같은 Wi-Fi/LAN에서 즉석으로 붙는, 화면 위에 몰래 떠 있는 미니게임 모음 오버레이",
  "author": "hyungi",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && npm run build:physics && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer',{recursive:true});fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "test": "npm run build && node tests/simulation.test.mjs && node tests/cell.test.mjs && node tests/fence.test.mjs && node tests/worm.test.mjs && node tests/merandi.test.mjs && node tests/tower.test.mjs && node tests/jumpmap.test.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "release:mac": "npm run build && electron-builder --mac --publish=never",
    "release:win": "npm run build && electron-builder --win --publish=never",
    "release:mac:publish": "npm run build && electron-builder --mac --publish=always",
    "release:win:publish": "npm run build && electron-builder --win --publish=always",
    "release:publish": "npm run build && electron-builder --mac --win --publish=always",
    "build:physics": "esbuild src/renderer/lib/tower-physics.ts --bundle --format=esm --platform=browser --outfile=dist/renderer/lib/tower-physics.js",
    "test:tower-ui": "npm run build && electron tests/tower-renderer.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "planck": "^1.5.0",
    "poly-decomp": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "electron": "*",
    "electron-builder": "*",
    "esbuild": "^0.28.2",
    "typescript": "*"
  },
  "build": {
    "appId": "com.hyungi.overlaylupin",
    "productName": "Overlay Lupin",
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "yogurt-c",
      "repo": "overlay-lupin"
    },
    "mac": {
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "같은 Wi-Fi/LAN에 있는 다른 플레이어를 찾기 위해 로컬 네트워크 접근이 필요합니다.",
        "NSBonjourServices": [
          "_overlaylupin._udp"
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    }
  }
}
